# Copy to .env.local for local development. Set the same names in Vercel.

# Supabase → Project Settings → API. Both are public by design (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Photo show detection (#14) and email/photo import. Without it the
# log form still works, just without suggestions. Never prefix with NEXT_PUBLIC_.
# ANTHROPIC_API_KEY=

# Server-only. Waitlist sign-ups go to Kit, which sends the double opt-in email.
# Kit → Settings → Developer → v4 API key; the form ID is in the form's URL.
# Turn on double opt-in in the form's Incentive settings. Without these, sign-ups
# go to the Supabase `waitlist` table instead.
# KIT_API_KEY=
# KIT_FORM_ID=
