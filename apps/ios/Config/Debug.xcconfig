// Debug builds talk to local Supabase (`supabase start` in the repo root).
// The Simulator shares the Mac's network, so 127.0.0.1 is the Mac.
// `/$()/` stops xcconfig reading `//` as a comment.
// The key is the fixed one every local Supabase stack uses.

#include "Shared.xcconfig"

SUPABASE_URL = http:/$()/127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY = sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
WEB_URL = http:/$()/127.0.0.1:3000

// Optional, git-ignored: point Debug at another project (e.g. a real device
// against hosted Supabase). See Secrets.example.xcconfig.
#include? "Secrets.xcconfig"
