// Settings for the Stubbed app target. Debug.xcconfig and Release.xcconfig
// include this and add the Supabase project each build talks to.

PRODUCT_NAME = Stubbed
PRODUCT_BUNDLE_IDENTIFIER = com.felixng.stubbed
DEVELOPMENT_TEAM = AAW3XNQ6D3
CODE_SIGN_STYLE = Automatic
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// iPhone only, portrait, iOS 17+ (docs/ARCHITECTURE.md §5).
TARGETED_DEVICE_FAMILY = 1
IPHONEOS_DEPLOYMENT_TARGET = 17.0

INFOPLIST_FILE = Config/Info.plist
CODE_SIGN_ENTITLEMENTS = Config/Stubbed.entitlements
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Stubbed
INFOPLIST_KEY_NSPhotoLibraryAddUsageDescription = Stubbed saves your share cards to Photos when you tap Download.
// HTTPS only: no export-compliance questions on each upload.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.lifestyle
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_PREVIEWS = YES
SWIFT_EMIT_LOC_STRINGS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
