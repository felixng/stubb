#!/usr/bin/env bash
# Build, test and run the iOS app from the command line, without Xcode's UI,
# so Claude Code (including a remote session on this Mac) can work on it.
#
#   scripts/dev build          Build for the Simulator
#   scripts/dev test           Run the unit tests on the Simulator
#   scripts/dev ui [Class[/test]]   Run UI tests (StubbedUITests) as the
#                              local test users; screenshots go to build/ui/
#   scripts/dev archive        Archive a Release build and upload it to
#                              TestFlight (needs the owner's Apple account
#                              signed in to Xcode)
#   scripts/dev test-users     Create or reset the local test users
#                              (ios-test@ and ios-new@stubbed.local)
#   scripts/dev run [png]      Build, install, launch, then save a screenshot
#   scripts/dev screenshot [png]   Screenshot the running Simulator
#   scripts/dev logs [secs]    Print the app's recent log lines (default 30s)
#   scripts/dev types          Regenerate Stubbed/Generated/Database.swift
#                              from local Supabase
#
# SIM picks the Simulator by name (default "iPhone 17 Pro"). Output goes to
# apps/ios/build/ (git-ignored); full xcodebuild logs are in build/logs/.
set -euo pipefail

IOS_DIR="$(cd "$(dirname "$0")/.." && pwd)"
REPO_DIR="$(cd "$IOS_DIR/../.." && pwd)"
BUILD_DIR="$IOS_DIR/build"
DERIVED="$BUILD_DIR/DerivedData"
SIM="${SIM:-iPhone 17 Pro}"
BUNDLE_ID="com.felixng.stubbed"
APP="$DERIVED/Build/Products/Debug-iphonesimulator/Stubbed.app"

mkdir -p "$BUILD_DIR/logs"

# UDID of the named Simulator on the newest iOS runtime that has it.
sim_udid() {
  xcrun simctl list devices available -j | /usr/bin/python3 -c '
import json, sys
name = sys.argv[1]
runtimes = json.load(sys.stdin)["devices"]
def version(key):
    return [int(p) for p in key.rsplit("iOS-", 1)[-1].split("-") if p.isdigit()]
for key in sorted((k for k in runtimes if ".iOS-" in k), key=version, reverse=True):
    for device in runtimes[key]:
        if device["name"] == name:
            print(device["udid"]); sys.exit(0)
sys.exit("No available Simulator named " + repr(name) + ". Try: xcrun simctl list devices available")
' "$SIM"
}

boot() {
  local udid="$1"
  xcrun simctl bootstatus "$udid" -b >/dev/null
}

xcb() {
  local action="$1" udid="$2" log="$BUILD_DIR/logs/$1.log"
  shift 2
  set +e
  xcodebuild "$action" "$@" \
    -project "$IOS_DIR/Stubbed.xcodeproj" \
    -scheme Stubbed \
    -configuration Debug \
    -destination "platform=iOS Simulator,id=$udid" \
    -derivedDataPath "$DERIVED" \
    -skipPackagePluginValidation \
    >"$log" 2>&1 &
  local pid=$! finished=""
  # xcodebuild sometimes hangs after UI tests finish. Once the last test
  # suite has reported, give it 30s to exit, then stop it.
  while kill -0 "$pid" 2>/dev/null; do
    if [ -z "$finished" ] && grep -qE "Test Suite '(Selected|All) tests' (passed|failed)" "$log"; then
      finished=$SECONDS
    fi
    if [ -n "$finished" ] && [ $((SECONDS - finished)) -ge 30 ]; then
      kill "$pid" 2>/dev/null
      grep -qE "Test Suite '(Selected|All) tests' passed" "$log" && echo "** TEST SUCCEEDED **" >>"$log" || echo "** TEST FAILED **" >>"$log"
      break
    fi
    sleep 1
  done
  wait "$pid" 2>/dev/null
  local status=$?
  grep -q "\*\* TEST SUCCEEDED \*\*" "$log" && status=0
  set -e
  # Keep the output short: errors, warnings in our code, test results, verdict.
  grep -E "error:|warning: .*/apps/ios/Stubbed|Test (Suite|Case|case|run)|✔|✘|\*\* .* (SUCCEEDED|FAILED) \*\*" "$log" \
    | grep -v "/SourcePackages/" | sort -u | tail -60 || true
  [ $status -eq 0 ] || echo "xcodebuild $action failed. Full log: $log" >&2
  return $status
}

screenshot() {
  local udid="$1" out="${2:-$BUILD_DIR/screenshot.png}"
  xcrun simctl io "$udid" screenshot --type=png "$out" >/dev/null 2>&1
  echo "Screenshot: $out"
}

# Local-only accounts for UI tests, created with the service role key from
# `supabase status` (sign-ups are off). The main one has a handle; the "new"
# one is deleted and recreated before every UI run, so it always starts at
# the welcome screen (a handle can't be removed once set).
TEST_EMAIL="ios-test@stubbed.local"
NEW_EMAIL="ios-new@stubbed.local"
# Someone the test user follows, with a page and a bit of public shows.
FRIEND_EMAIL="ios-friend@stubbed.local"
# Someone with a follow request waiting for the test user's approval.
FAN_EMAIL="ios-fan@stubbed.local"
TEST_PASSWORD="stubbed-ios"
TEST_HANDLE="ios_test"

admin() {
  local method="$1" path="$2" body="${3:-}"
  curl -s -X "$method" "$SB_API$path" -H "apikey: $SB_KEY" -H "Authorization: Bearer $SB_KEY" \
    -H "Content-Type: application/json" ${body:+-d "$body"}
}

user_id() {
  admin GET "/auth/v1/admin/users?per_page=1000" \
    | /usr/bin/python3 -c 'import json,sys; print(next((u["id"] for u in json.load(sys.stdin)["users"] if u["email"]==sys.argv[1]), ""))' "$1"
}

test_users() {
  local env id
  env="$(cd "$REPO_DIR" && supabase status -o env 2>/dev/null)" || { echo "Local Supabase isn't running: supabase start" >&2; exit 1; }
  SB_API="$(sed -n 's/^API_URL="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' <<<"$env")"
  SB_KEY="$(sed -n 's/^SERVICE_ROLE_KEY="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' <<<"$env")"
  local user="{\"password\":\"$TEST_PASSWORD\",\"email_confirm\":true"

  admin POST /auth/v1/admin/users "$user,\"email\":\"$TEST_EMAIL\"}" >/dev/null
  admin POST /auth/v1/admin/users "$user,\"email\":\"$FRIEND_EMAIL\"}" >/dev/null
  admin POST /auth/v1/admin/users "$user,\"email\":\"$FAN_EMAIL\"}" >/dev/null
  id="$(user_id "$TEST_EMAIL")"
  admin PATCH "/rest/v1/profiles?id=eq.$id&handle=is.null" "{\"handle\":\"$TEST_HANDLE\",\"display_name\":\"iOS Test\"}" >/dev/null

  id="$(user_id "$NEW_EMAIL")"
  [ -n "$id" ] && admin DELETE "/auth/v1/admin/users/$id" >/dev/null
  admin POST /auth/v1/admin/users "$user,\"email\":\"$NEW_EMAIL\"}" >/dev/null
  docker exec -i supabase_db_stubbed psql -q -U postgres -d postgres -v ON_ERROR_STOP=1 <"$IOS_DIR/scripts/test-seed.sql" >/dev/null \
    || { echo "Seeding the test diary failed" >&2; exit 1; }
  echo "Test users: $TEST_EMAIL (@$TEST_HANDLE) and $NEW_EMAIL (no handle), password $TEST_PASSWORD"
}

cmd="${1:-build}"
shift || true

case "$cmd" in
  build)
    xcb build "$(sim_udid)"
    ;;
  test)
    udid="$(sim_udid)"
    boot "$udid"
    xcb test "$udid" -only-testing:StubbedTests
    ;;
  ui)
    udid="$(sim_udid)"
    boot "$udid"
    rm -rf "$BUILD_DIR/ui" && mkdir -p "$BUILD_DIR/ui"
    # A copy started by `run` can't be closed by XCUITest and stalls it.
    xcrun simctl terminate "$udid" "$BUNDLE_ID" >/dev/null 2>&1 || true
    test_users >/dev/null
    # Test photos (scripts/fixtures), added once per Simulator.
    if [ ! -f "$BUILD_DIR/.media-$udid" ]; then
      xcrun simctl addmedia "$udid" "$IOS_DIR"/scripts/fixtures/*.jpg && touch "$BUILD_DIR/.media-$udid"
    fi
    # Build once, then run each test class against freshly reset test data,
    # so one class's changes (a deleted account, a trip edit) can't leak
    # into the next. TEST_RUNNER_X reaches the UI test process as X.
    xcb build-for-testing "$udid" >/dev/null || { tail -20 "$BUILD_DIR/logs/build-for-testing.log"; exit 1; }
    if [ -n "${1:-}" ]; then
      classes="$1"
    else
      classes="$(grep -ho 'final class [A-Za-z]*UITests' "$IOS_DIR"/StubbedUITests/*.swift | awk '{print $3}' | sort)"
    fi
    failed=0
    : >"$BUILD_DIR/logs/ui-all.log"
    for class in $classes; do
      test_users >/dev/null
      TEST_RUNNER_STUBBED_EMAIL="$TEST_EMAIL" TEST_RUNNER_STUBBED_NEW_EMAIL="$NEW_EMAIL" \
        TEST_RUNNER_STUBBED_PASSWORD="$TEST_PASSWORD" \
        TEST_RUNNER_STUBBED_SCREENSHOTS="$BUILD_DIR/ui" \
        xcb test-without-building "$udid" "-only-testing:StubbedUITests/$class" || failed=1
      cat "$BUILD_DIR/logs/test-without-building.log" >>"$BUILD_DIR/logs/ui-all.log"
    done
    ls "$BUILD_DIR/ui"/*.png 2>/dev/null | sed 's/^/Screenshot: /' || true
    [ $failed -eq 0 ] && echo "** UI TESTS SUCCEEDED **" || { echo "** UI TESTS FAILED **"; exit 1; }
    ;;
  test-users)
    test_users
    ;;
  archive)
    # Release talks to the hosted Supabase project (Config/Release.xcconfig).
    archive="$BUILD_DIR/Stubbed.xcarchive"
    rm -rf "$archive"
    xcodebuild archive -project "$IOS_DIR/Stubbed.xcodeproj" -scheme Stubbed -configuration Release \
      -destination "generic/platform=iOS" -archivePath "$archive" -allowProvisioningUpdates \
      CURRENT_PROJECT_VERSION="${BUILD_NUMBER:-$(date +%Y%m%d%H%M)}" >"$BUILD_DIR/logs/archive.log" 2>&1 \
      || { grep -E "error:" "$BUILD_DIR/logs/archive.log" | head -20; echo "Archive failed. Full log: $BUILD_DIR/logs/archive.log" >&2; exit 1; }
    xcodebuild -exportArchive -archivePath "$archive" -exportOptionsPlist "$IOS_DIR/Config/ExportOptions.plist" \
      -exportPath "$BUILD_DIR/export" -allowProvisioningUpdates >"$BUILD_DIR/logs/export.log" 2>&1 \
      || { grep -E "error" "$BUILD_DIR/logs/export.log" | head -20; echo "Upload failed. Full log: $BUILD_DIR/logs/export.log" >&2; exit 1; }
    echo "Uploaded to App Store Connect. It appears in TestFlight once processed (a few minutes)."
    ;;
  run)
    udid="$(sim_udid)"
    boot "$udid"
    xcb build "$udid"
    xcrun simctl install "$udid" "$APP"
    xcrun simctl launch --terminate-running-process "$udid" "$BUNDLE_ID" >/dev/null
    sleep "${WAIT:-3}"
    screenshot "$udid" "${1:-}"
    ;;
  screenshot)
    screenshot "$(sim_udid)" "${1:-}"
    ;;
  logs)
    xcrun simctl spawn "$(sim_udid)" log show --style compact --last "${1:-30}s" \
      --predicate "subsystem BEGINSWITH '$BUNDLE_ID' OR process == 'Stubbed'"
    ;;
  types)
    out="$IOS_DIR/Stubbed/Generated/Database.swift"
    (cd "$REPO_DIR" && supabase gen types --lang swift --local --swift-access-control internal 2>/dev/null) \
      | sed -E 's/case (public|private|internal|default|in|is|as|do|if|for) = /case `\1` = /' >"$out"
    echo "Wrote $out ($(wc -l <"$out" | tr -d ' ') lines)"
    ;;
  *)
    sed -n '2,13p' "$0"
    exit 1
    ;;
esac
